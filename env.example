# ============================================
# ПОЛНЫЙ ФАЙЛ .env ДЛЯ AutoSites
# Скопируй: cp env.example .env
# ============================================

# ===== PostgreSQL =====
PG_USER=autosites
PG_PASSWORD=ТВОЙ_ПАРОЛЬ_БД
PG_DB_APP=app_db
PG_DB_N8N=n8n_db

# ===== Timezone =====
TZ=Europe/Moscow
GENERIC_TIMEZONE=Europe/Moscow

# ===== n8n =====
N8N_ENCRYPTION_KEY=СГЕНЕРИРУЙ_ДЛИННЫЙ_КЛЮЧ_32_СИМВОЛА

# ===== OpenAI =====
OPENAI_API_KEY=sk-proj-ТВОЙ_КЛЮЧ_OPENAI

# ===== Telegram Bot =====
TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=123456789,987654321

# ===== Admin Panel =====
ADMIN_PASSWORD=твой_секретный_пароль_для_админки

# ===== Yandex Cloud S3 =====
S3_ACCESS_KEY=ТВОЙ_S3_ACCESS_KEY
S3_SECRET_KEY=ТВОЙ_S3_SECRET_KEY
S3_BUCKET=autosites-uploads
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_PUBLIC_URL=https://storage.yandexcloud.net/autosites-uploads

# ===== n8n Webhook =====
# URL для отправки заявок на генерацию сайта
#
# ВАЖНО: Workflow должен быть АКТИВИРОВАН в n8n!
#
# Для тестирования (работает без активации workflow):
# N8N_WEBHOOK_URL=http://n8n-main:5678/webhook-test/tg-site-gen
# Или: https://autosites.ru/n8n/webhook-test/tg-site-gen
#
# Для продакшена (требует активации workflow):
# N8N_WEBHOOK_URL=http://n8n-main:5678/webhook/tg-site-gen
# Или: https://autosites.ru/n8n/webhook/tg-site-gen
#
# Чтобы получить URL:
# 1. Открой workflow в n8n редакторе
# 2. Нажми на Webhook ноду
# 3. Скопируй "Test URL" (для теста) или "Production URL" (для прода)
# 4. Убедись что workflow АКТИВИРОВАН (toggle в правом верхнем углу)
N8N_WEBHOOK_URL=http://n8n-main:5678/webhook-test/tg-site-gen

# Legacy aliases (для совместимости)
YC_S3_KEY=${S3_ACCESS_KEY}
YC_S3_SECRET=${S3_SECRET_KEY}
YC_S3_BUCKET=${S3_BUCKET}
YC_S3_ENDPOINT=${S3_ENDPOINT}
YC_S3_REGION=${S3_REGION}

