# ============================================
# AutoSites Environment Configuration
# Copy this file: cp env.example .env
# ============================================

# ===== Database =====
DATABASE_URL=postgresql://autosites:YOUR_DB_PASSWORD@postgres:5432/autosites
# Or use separate variables:
# DB_USER=autosites
# DB_PASSWORD=YOUR_DB_PASSWORD
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=autosites

# ===== Telegram Bot =====
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ===== WebApp URL =====
# URL where Telegram Mini App is hosted
WEBAPP_URL=https://your-domain.com

# ===== Admin =====
# Comma-separated list of Telegram user IDs who can be admins
ADMIN_IDS=123456789,987654321
# Password for admin login
ADMIN_PASSWORD=your_secure_admin_password

# ===== API Settings =====
API_PORT=8000
DEBUG=false
CORS_ORIGINS=["*"]

# ===== S3 Storage (Yandex Cloud / AWS compatible) =====
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=autosites-uploads
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_PUBLIC_URL=https://storage.yandexcloud.net/autosites-uploads

# ===== n8n Webhooks =====
# Standard tariff: URL for standard site generation workflow
# Test URL (works without workflow activation):
# N8N_WEBHOOK_URL=http://n8n:5678/webhook-test/tg-site-gen
# Production URL (requires workflow activation):
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/tg-site-gen
N8N_WEBHOOK_URL=

# Premium tariff: URL for premium site generation workflow
# Test URL: http://n8n:5678/webhook-test/tg-site-gen-premium
# Production URL: http://n8n:5678/webhook/tg-site-gen-premium
N8N_PREMIUM_WEBHOOK_URL=

# URL for revision processing workflow (правки сайтов)
# Webhook path from n8n workflow: /webhook/tg-site-revision
# Test URL: http://n8n:5678/webhook-test/tg-site-revision
# Production URL: http://n8n:5678/webhook/tg-site-revision
N8N_REVISIONS_WEBHOOK_URL=

# ===== Bot Webhook =====
# URL for bot notifications (additional services, feedback)
# Should point to bot container's webhook port
# Container name: autosites-bot (check with: docker ps | grep bot)
BOT_WEBHOOK_URL=http://autosites-bot:8081
BOT_WEBHOOK_PORT=8081

# ===== Deploy Node =====
# URL of main-deploy-node for site deployment
DEPLOY_NODE_URL=http://deploy-node:8080
# Auto-deploy sites after generation (default: true - enabled)
# Set to false to disable automatic deployment
AUTO_DEPLOY_ENABLED=true
# Secret for secure webhook callbacks from deploy-node
DEPLOY_CALLBACK_SECRET=your_callback_secret

# ===== API Public URL =====
# Public URL of this API for callbacks from n8n
# Used by n8n to send revision completion callbacks
# Example: https://api.autosites.ru or http://api:8000 (docker internal)
API_PUBLIC_URL=http://api:8000

# ===== Payment Settings =====
# Base URL for payment system (leave empty for manual payment confirmation)
PAYMENT_BASE_URL=
# Bank account for SBP QR payments
PAYMENT_BANK_ACCOUNT=

# ===== Timezone =====
TZ=Europe/Moscow

# ===== Manager Registration =====
# Bot username for invite links (without @)
BOT_USERNAME=wenlix_bot
